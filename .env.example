# Aplicación local (Vercel define NODE_ENV y VERCEL_ENV automáticamente)
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Neon PostgreSQL
# DATABASE_URL: conexión pooled (-pooler) para runtime
# DIRECT_URL: conexión directa para migraciones controladas
DATABASE_URL=
DIRECT_URL=

# Correo transaccional
EMAIL_PROVIDER=mock
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=notificaciones@xs-abogados.com
EMAIL_FROM_NAME="XS ABOGADOS"
EMAIL_REPLY_TO=
CONTACT_RECIPIENT_EMAIL=contacto@xs-abogados.com
BREVO_SANDBOX_MODE=false

# Compatibilidad temporal con Resend (no es necesario para producción)
RESEND_API_KEY=
EMAIL_FROM="XS ABOGADOS <notificaciones@xs-abogados.com>"

# Calendario
CALENDAR_PROVIDER=mock
NEXT_PUBLIC_CALENDAR_PROVIDER=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
ALLOW_MOCK_CALENDAR_IN_PRODUCTION=false

# Autenticación y datos DEMO (solo local o Preview)
ENABLE_DEMO_AUTH=false
ALLOW_DATABASE_SEED=false
DEMO_ADMIN_PASSWORD=
DEMO_CLIENT_PASSWORD=
DEMO_LAWYER_PASSWORD=

# Límites de solicitudes
RATE_LIMIT_PROVIDER=database
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_SALT=

# Almacenamiento privado
STORAGE_PROVIDER=local
PRIVATE_UPLOAD_DIR=.data/uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Datos públicos configurables (nunca colocar secretos NEXT_PUBLIC)
NEXT_PUBLIC_WHATSAPP_NUMBER=523329602391
NEXT_PUBLIC_PHONE_DISPLAY="+52 33 2960 2391"
NEXT_PUBLIC_CONTACT_EMAIL=contacto@xs-abogados.com
NEXT_PUBLIC_OFFICE_ADDRESS="Torre Celtis, Piso 18, Real de Acueducto 240, Puerta de Hierro, 45116 Zapopan, Jal."
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_PORTAL=true

# Vercel las inyecta; se muestran solo como referencia y no se configuran a mano
VERCEL_ENV=
VERCEL_URL=
VERCEL_PROJECT_PRODUCTION_URL=
